ADMIN_USERNAME=adminarea
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_DATA_FILE=./data/admin-data.json
NEXT_PUBLIC_SITE_URL=https://storyboundhouse.com

# Outgoing enquiry notifications. Add real values privately to .env.local / hosting environment.
# 465 uses implicit TLS; 587 uses required STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# A sender mailbox authorized by your email host, e.g. info@storyboundhouse.com
SMTP_FROM=
# Security deployment settings
# Public production origin, including https:// (required for production form requests).
# NEXT_PUBLIC_SITE_URL=https://storyboundhouse.com
# Set ONLY when your reverse proxy strips/overwrites this header.
# TRUSTED_PROXY_IP_HEADER=x-real-ip

# Google reCAPTCHA v3: register production hostname + localhost for development.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
